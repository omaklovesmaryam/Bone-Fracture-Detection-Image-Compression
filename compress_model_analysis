axes[0,1].set_ylabel('Test Accuracy (%)', fontweight='bold')
axes[0,1].set_xlabel('Training Time (minutes)', fontweight='bold')
axes[0,1].set_ylim(65, 80)

# Add labels to points
for i, row in clean_df.iterrows():
    axes[0,1].annotate(row['compression_type'].replace('_corrected', ''), 
                      (row['training_time_minutes'], row['test_accuracy']*100),
                      xytext=(5, 5), textcoords='offset points', fontsize=9)

# Add legend
